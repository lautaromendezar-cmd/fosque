# Fosque — sitio estatico (Next.js export). Apache / hosting compartido.

DirectoryIndex index.html

# --- Pagina de error propia -------------------------------------------------
ErrorDocument 404 /404.html

# --- HTTPS y host canonico --------------------------------------------------
# ⛔ ACA NO SE PUEDE USAR mod_rewrite. NUNCA. El vhost tiene FollowSymLinks y
# SymLinksIfOwnerMatch APAGADOS, y en ese caso Apache prohibe RewriteRule y
# contesta 403 a TODO el sitio (no al pedido que matchea: a todo). Probado en
# vivo el 3-sep: un RewriteRule de www -> apex dejo fosque.com entero en 403 y
# el error_log lo dice con nombre y apellido:
#
#   AH00670: Options FollowSymLinks and SymLinksIfOwnerMatch are both off, so
#   the RewriteRule directive is also forbidden ... /users/webs/fosque.com/htdocs/
#
# Por eso tampoco existe mas el bloque de "forzar HTTPS" comentado que venia
# aca: si alguien lo descomentaba, tiraba el sitio igual. No hace falta: el
# hosting YA redirige http -> https solo, a nivel de servidor.
#
# Si algun dia hace falta el 301 de www -> fosque.com, hay que pedirle al
# hosting que habilite Options +FollowSymLinks (o que haga el 301 ellos en el
# vhost). Mientras tanto lo cubre el <link rel="canonical"> que llevan las 9
# paginas: apuntan todas a https://fosque.com/... asi que Google se queda con
# el dominio propio igual.

# --- Compresion -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Los .woff2, .mp4, .jpg y .png YA vienen comprimidos: no re-comprimir.
</IfModule>

# --- Tipos MIME (por si el hosting es viejo y no los trae) ------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Cache ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # El HTML NO se cachea: si no, subis un cambio por FTP y nadie lo ve.
  ExpiresByType text/html "access plus 0 seconds"
  # Los assets de /_next/static llevan hash en el nombre: cache eterno seguro.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Media: nombre fijo, cache corto para poder reemplazar videos y fotos.
  ExpiresByType video/mp4 "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

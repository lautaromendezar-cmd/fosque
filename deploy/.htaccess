# Fosque — sitio estatico (Next.js export). Apache / hosting compartido.

DirectoryIndex index.html

# --- Pagina de error propia -------------------------------------------------
ErrorDocument 404 /404.html

# --- HTTPS y host canonico --------------------------------------------------
# SSL RESUELTO (3-sep-2026): el hosting emitio un Let's Encrypt que cubre
# fosque.com Y www.fosque.com, y ya redirige http -> https EL SOLO a nivel de
# servidor (http://fosque.com devuelve 301 con la raiz todavia vacia). Por eso
# el "forzar HTTPS" queda comentado: seria redundante y, si el hosting termina
# el TLS en un proxy, %{HTTPS} llega en off y se arma un loop infinito.
# Descomentarlo SOLO si algun dia http:// deja de redirigir solo.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

# www -> apex. El canonical y el og:image se hornean con https://fosque.com:
# sin esto el sitio queda servido igual en los dos hosts y Google lo indexa
# duplicado. Si www tuviera su propia carpeta, esta regla simplemente no corre.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.fosque\.com$ [NC]
  RewriteRule ^(.*)$ https://fosque.com/$1 [R=301,L]
</IfModule>

# --- Compresion -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Los .woff2, .mp4, .jpg y .png YA vienen comprimidos: no re-comprimir.
</IfModule>

# --- Tipos MIME (por si el hosting es viejo y no los trae) ------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Cache ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # El HTML NO se cachea: si no, subis un cambio por FTP y nadie lo ve.
  ExpiresByType text/html "access plus 0 seconds"
  # Los assets de /_next/static llevan hash en el nombre: cache eterno seguro.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Media: nombre fijo, cache corto para poder reemplazar videos y fotos.
  ExpiresByType video/mp4 "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
